# Local dev only. Production secrets come from the managed vault (SEC-05),
# never from a file. Copy to .env for local runs: `cp .env.example .env`.
EADIP_ENVIRONMENT=dev
EADIP_LOG_JSON=true
EADIP_OTEL_ENABLED=false
# EADIP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
EADIP_POSTGRES_DSN=postgresql://eadip:eadip@localhost:5432/eadip
EADIP_REDIS_URL=redis://localhost:6379/0
EADIP_QDRANT_URL=http://localhost:6333
EADIP_NEO4J_URI=bolt://localhost:7687
EADIP_DEFAULT_MODEL=gpt-4o-mini
# EADIP_MODEL_API_BASE=
# Provider keys are read by LiteLLM from standard env vars, e.g.:
# OPENAI_API_KEY=sk-...

# --- Phase 2: identity, access & audit ---
# Persistence: false = in-memory adapters (no DB needed). When true the gateway
# uses Postgres (RLS) + the append-only audit log; run `eadip-migrate` first.
EADIP_DATABASE_ENABLED=false
# Auth: "dev" trusts X-Tenant-ID / X-User-ID / X-Roles headers; "oidc" verifies
# a Bearer JWT against the IdP.
EADIP_AUTH_MODE=dev
# EADIP_OIDC_ISSUER=https://your-idp.example/
# EADIP_OIDC_AUDIENCE=eadip
# EADIP_OIDC_JWKS_URI=https://your-idp.example/.well-known/jwks.json
# EADIP_OIDC_ROLES_CLAIM=roles
# EADIP_OIDC_TENANT_CLAIM=tenant
# Service-JWT signing key name (resolved from the vault, not stored here):
# EADIP_SECRET_SERVICE_JWT_SIGNING_KEY=...  # (only for non-dev EnvSecretsProvider)

# --- Glass Box ---
# Runs execute in the background and stream from an in-memory event log that
# keeps the newest N runs. Share links are signed with the service JWT key.
EADIP_EVENT_LOG_MAX_RUNS=500
EADIP_SHARE_LINK_TTL_S=604800
# Bring-your-own CSV (DuckDB backend only).
EADIP_DATASET_MAX_BYTES=5000000
EADIP_DATASET_MAX_COLUMNS=32
EADIP_DATASET_MAX_ROWS=100000
